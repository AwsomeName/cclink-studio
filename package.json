{
  "name": "cclink-studio",
  "productName": "CCLink Studio 开源版",
  "version": "0.1.81",
  "packageManager": "pnpm@11.5.0",
  "description": "An open-source AI-powered desktop workspace — embedded browser, document editor, and AI agent, all in one.",
  "main": "./out/main/index.js",
  "private": false,
  "license": "GPL-3.0-only",
  "author": "CCLink Studio Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AwsomeName/cclink-studio.git"
  },
  "homepage": "https://github.com/AwsomeName/cclink-studio#readme",
  "bugs": {
    "url": "https://github.com/AwsomeName/cclink-studio/issues"
  },
  "scripts": {
    "start": "bash scripts/restart.sh start",
    "stop": "bash scripts/restart.sh stop",
    "studio": "bash scripts/studio.sh",
    "studio:start": "bash scripts/studio.sh start",
    "studio:status": "bash scripts/studio.sh status",
    "studio:logs": "bash scripts/studio.sh logs",
    "studio:stop": "bash scripts/studio.sh stop",
    "studio:smoke": "bash scripts/studio.sh smoke",
    "dev": "ELECTRON_RUN_AS_NODE= bash scripts/dev.sh",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/ensure-electron-runtime.mjs && electron-builder install-app-deps",
    "package:local": "bash scripts/package.sh",
    "package:local:dev": "bash scripts/package.sh --dev",
    "release": "node scripts/oss-release.mjs",
    "release:oss": "node scripts/oss-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "pnpm typecheck:web && pnpm typecheck:node",
    "verify:oss-boundary": "node scripts/verify-oss-boundary.mjs && node --test scripts/verify-oss-boundary.test.mjs",
    "verify:package-boundary": "node --test scripts/package-boundary.test.mjs",
    "verify:credential-boundary": "node scripts/verify-credential-boundary.mjs",
    "verify:claude-scheduling-boundary": "node scripts/verify-claude-native-scheduling.mjs && node --test scripts/verify-claude-native-scheduling.test.mjs",
    "verify:context-actions": "node scripts/verify-context-action-boundary.mjs",
    "verify:release": "node --test scripts/oss-release-preflight.test.mjs scripts/oss-release-workflow.test.mjs scripts/oss-release.test.mjs scripts/release/update-manifest.test.mjs",
    "verify:update-manifest": "node scripts/release/verify-update-manifest.mjs",
    "stage:agent-runtime": "node scripts/stage-claude-runtime.mjs",
    "verify:agent-runtime": "node scripts/stage-claude-runtime.mjs --verify-only",
    "smoke:agent-runtime": "node scripts/smoke-claude-runtime.mjs",
    "smoke:cclink-agent": "node scripts/cclink-agent-smoke.mjs",
    "smoke:acp-runtime": "node scripts/acp-runtime-probe.mjs",
    "smoke:managed-claude-runtime": "CCLINK_MANAGED_RUNTIME_REAL_SMOKE=1 vitest run src/main/runtime-components/runtime-component-manager.test.ts -t 'downloads the real constrained npm package'",
    "smoke:managed-runtime-ui": "node scripts/managed-runtime-ui-smoke.mjs",
    "smoke:managed-runtime-packaged": "node scripts/managed-runtime-packaged-smoke.mjs",
    "verify": "pnpm verify:oss-boundary && pnpm verify:package-boundary && pnpm verify:credential-boundary && pnpm verify:claude-scheduling-boundary && pnpm verify:context-actions && pnpm verify:release && pnpm format:check && pnpm lint && pnpm test && pnpm build",
    "smoke:local": "node scripts/local-smoke.mjs",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:pdf-preview": "node scripts/ui-smoke.mjs --pdf-only",
    "smoke:media-production": "node scripts/media-production-smoke.mjs",
    "smoke:workflow": "node scripts/workflow-smoke.mjs",
    "smoke:restore": "node scripts/restore-smoke.mjs",
    "smoke:scheduled-tasks": "node scripts/scheduled-tasks-smoke.mjs",
    "smoke:scheduled-task-git-sharing": "node scripts/scheduled-task-git-sharing-smoke.mjs",
    "smoke:auth-window": "node scripts/auth-window-smoke.cjs",
    "smoke:browser-http-auth": "node scripts/browser-http-auth-smoke.cjs",
    "smoke:browser-cookie-security": "node scripts/browser-cookie-security-smoke.cjs",
    "smoke:browser-cdp-recovery": "pnpm build && node scripts/browser-cdp-recovery-smoke.cjs",
    "smoke:detachable-tabs-p0a": "node scripts/detachable-tabs-p0.cjs --controller-phase=p0a",
    "smoke:detachable-tabs-p0b": "node scripts/detachable-tabs-p0.cjs --controller-phase=p0b",
    "smoke:detachable-tabs-p0": "node scripts/detachable-tabs-p0.cjs --controller-phase=all",
    "smoke:detachable-tabs-m1": "node scripts/detachable-tabs-m1-smoke.mjs",
    "smoke:standalone": "pnpm smoke:local && pnpm smoke:ui && pnpm smoke:workflow && pnpm smoke:restore && pnpm smoke:update-recovery",
    "smoke:update-recovery": "node scripts/update-recovery-smoke.mjs",
    "lint": "eslint src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "dev:bg": "bash scripts/restart.sh start",
    "dev:stop": "bash scripts/restart.sh stop",
    "dev:status": "bash scripts/restart.sh status",
    "dev:logs": "bash scripts/restart.sh logs",
    "restart": "bash scripts/restart.sh",
    "restart:dev": "bash scripts/restart.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.211",
    "@anthropic-ai/sdk": "^0.111.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tencentcloud/chat": "3.6.6",
    "@yume-chan/adb": "^2.6.0",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/event": "^2.0.0",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.3",
    "@yume-chan/stream-extra": "^2.5.3",
    "agent-device": "^0.17.2",
    "events-universal": "1.0.1",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.11.1",
    "juice": "^12.1.0",
    "markdown-it": "^14.2.0",
    "marked": "^17.0.6",
    "node-pty": "^1.1.0",
    "occt-import-js": "^0.0.23",
    "playwright-core": "^1.52.0",
    "tar-stream": "^3.2.0",
    "text-decoder": "1.2.7",
    "ws": "8.21.0",
    "xhr2": "0.2.1",
    "yauzl": "^3.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@agentclientprotocol/codex-acp": "1.3.0",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-code-block-lowlight": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-list-item": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-cell": "^3.25.0",
    "@tiptap/extension-table-header": "^3.25.0",
    "@tiptap/extension-table-row": "^3.25.0",
    "@tiptap/extension-task-item": "^3.25.0",
    "@tiptap/extension-task-list": "^3.25.0",
    "@tiptap/markdown": "^3.25.0",
    "@tiptap/pm": "^3.25.0",
    "@tiptap/react": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tar-stream": "^3.1.4",
    "@types/three": "^0.185.0",
    "@types/yauzl": "^3.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "lowlight": "^3.3.0",
    "pdfjs-dist": "^5.7.284",
    "prettier": "^3.8.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.6",
    "zustand": "^5.0.14"
  }
}
